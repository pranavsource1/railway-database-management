# Railway Management System - Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railway_system

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Database Connection Pool Settings
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=0

# Optional: Logging
LOG_LEVEL=info

# Note: For development, these defaults are fine.
# For production, use strong passwords and secure connection methods.
